# Resolyx Frontend Environment Configuration Example
# Copy this file to .env.local for local overrides

# Application Base URL
VITE_APP_URL=http://localhost:3000

# Backend Connection
# In development, the Vite server proxies /api to http://localhost:8000
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8000

# Optional custom brand logo path (defaults to /brand/resolyx.png)
VITE_BRAND_LOGO_PATH=/brand/resolyx.png
